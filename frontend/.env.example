# Copy to .env.local for local development.
# On Vercel set this under Settings -> Environment Variables instead.
#
# Vite inlines this at BUILD time rather than reading it at runtime, so
# changing it on Vercel requires a redeploy to take effect.
# Exposed to client code by the API_ entry in envPrefix (vite.config.ts).
API_BASE_URL=http://localhost:8000
