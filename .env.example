# Copy to .env for local development. On Render, set these under
# Dashboard -> your service -> Environment.

# --- Required ---
GROQ_API_KEY=
TAVILY_API_KEY=
ASSEMBLYAI_API_KEY=
GOOGLE_API_KEY=

# --- Resource profile -------------------------------------------------------
# onnx  = fastembed/onnxruntime, ~150 MB   (required for a 512 MB instance)
# torch = sentence-transformers, ~620 MB   (needs >= 2 GB RAM)
EMBEDDING_BACKEND=onnx

# Cross-encoder reranking. Costs ~96 MB resident.
# Measured peak RSS on the onnx backend, with BM25 off:
#   true  -> ~441 MB fresh, ~511 MB under sustained traffic  (will OOM a 512 MB box)
#   false -> ~345 MB fresh, ~415 MB under sustained traffic
# Leave false on a 512 MB instance; set true on 2 GB for better ranking.
ENABLE_RERANK=false

# BM25 hybrid retrieval costs ~335 MB for this corpus. Leave false on 512 MB.
ENABLE_BM25=false

# Query expansion via extra LLM calls.
ENABLE_MULTIQUERY=true

# --- App --------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Comma-separated browser origins, or * to allow all.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_TO_FILE=false
